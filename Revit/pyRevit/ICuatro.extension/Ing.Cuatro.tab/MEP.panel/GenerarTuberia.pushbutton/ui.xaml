<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generar Tuberia NWD"
        Height="780" Width="1240"
        MinHeight="620" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="12"
        Background="#F4F5F7">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#EAECEF"/>
            <Setter Property="BorderBrush" Value="#C0C6CF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="Primario" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#005FB8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#004C99"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Dato" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Name="contenido" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#E8EDF5" CornerRadius="3"
                Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Modelo de coordinacion NWD/IFC (opcional)"
                               FontWeight="SemiBold"/>
                    <TextBlock Name="txt_cabecera" Style="{StaticResource Dato}"
                               Margin="0,3,0,0" Text="Sin verificar."/>
                </StackPanel>
                <Button Grid.Column="1" Name="btn_verificar_nwd"
                        Content="Verificar NWD/IFC..."
                        VerticalAlignment="Center"
                        Click="on_verificar_nwd"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" Margin="0,0,8,0"
                          VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Elementos de Revit">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Dato}" Margin="2,0,2,6"
                                   Text="Puedes trabajar en Revit con esta ventana abierta. Elige uno de los dos modos para llenar la tabla."/>
                        <Button Name="btn_sel_revit"
                                Content="Usar seleccion de Revit"
                                Click="on_usar_seleccion"/>
                        <Button Name="btn_sel_pick"
                                Content="Escoger en pantalla (Esc termina)..."
                                Click="on_escoger"/>
                        <TextBlock Name="txt_seleccion" Margin="2,7,0,0"
                                   Style="{StaticResource Dato}"
                                   Text="Ningun elemento seleccionado."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Familia de tuberia (Tubo/Conduit, MEP electricidad)">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" Name="cmb_tipo_tuberia"
                                      Margin="3" FontWeight="Normal"
                                      DisplayMemberPath="Etiqueta"
                                      SelectionChanged="on_tipo_tuberia_cambiado"/>
                            <Button Grid.Column="1" Name="btn_tipo_tuberia"
                                    Content="Actualizar" Padding="6,4"
                                    ToolTip="Vuelve a leer las familias de tuberia del proyecto"
                                    Click="on_actualizar_tipos_tuberia"/>
                        </Grid>
                        <TextBlock Name="txt_tipo_tuberia_nombre" Margin="3,1,3,0"
                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                   Text="Sin asignar"/>
                        <TextBlock Name="txt_tipo_tuberia_id" Margin="3,0,3,0"
                                   Foreground="#64748B" FontSize="10"
                                   Text=""/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Profundidad">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Dato}" Margin="2,0,2,4"
                                   Text="Distancia medida desde el punto base de cada elemento a la que entra la tuberia. Si queda fuera del elemento, se ajusta a su centro."/>
                        <TextBox Name="txt_profundidad" Text="0"/>
                        <TextBlock Style="{StaticResource Dato}" Margin="2,3,2,0"
                                   Foreground="#64748B" FontSize="10"
                                   Text="Metros, positivo = hacia abajo. Con NWD/IFC verificado, la tuberia desde CAD se mantiene a esta profundidad bajo el terreno en todo su recorrido."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="CAD vinculado (opcional): tuberia desde capas">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" Name="cmb_cad"
                                      Margin="3" FontWeight="Normal"
                                      DisplayMemberPath="Etiqueta"
                                      SelectionChanged="on_cad_cambiado"/>
                            <Button Grid.Column="1" Name="btn_detectar_cad"
                                    Content="Detectar" Padding="6,4"
                                    ToolTip="Vuelve a buscar vinculos e importaciones CAD en el documento"
                                    Click="on_detectar_cad"/>
                        </Grid>
                        <TextBlock Name="txt_cad_resumen" Margin="3,1,3,4"
                                   Style="{StaticResource Dato}"
                                   Text="Sin archivos CAD."/>
                        <ListView Name="lv_capas" Height="170"
                                  BorderBrush="#D0D5DD" FontWeight="Normal">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Sel." Width="40">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Marcada}"
                                                          Click="on_marcar_capa"
                                                          HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Capa" Width="150"
                                                    DisplayMemberBinding="{Binding Nombre}"/>
                                    <GridViewColumn Header="Segm." Width="50"
                                                    DisplayMemberBinding="{Binding Segmentos}"/>
                                    <GridViewColumn Header="Long. (m)" Width="65"
                                                    DisplayMemberBinding="{Binding Longitud}"/>
                                    <GridViewColumn Header="3D" Width="34"
                                                    DisplayMemberBinding="{Binding Cota3D}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <Button Name="btn_crear_cad"
                                Content="CREAR TUBERIA DESDE CAPAS"
                                Style="{StaticResource Primario}"
                                Margin="3,6,3,3" Click="on_crear_desde_cad"/>
                        <TextBlock Style="{StaticResource Dato}" Margin="2,2,2,0"
                                   Foreground="#64748B" FontSize="10"
                                   Text="Las lineas y polilineas de las capas marcadas se encadenan en recorridos continuos. Cota: terreno del NWD/IFC menos profundidad (si esta verificado) o cota del CAD menos profundidad."/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#E8EDF5" CornerRadius="3"
                        Padding="8" Margin="0,0,0,6">
                    <TextBlock Name="txt_conteo" Style="{StaticResource Dato}"
                               Text="0 elementos"/>
                </Border>

                <ListView Grid.Row="1" Name="lv_elementos"
                          BorderBrush="#D0D5DD">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Sel." Width="42">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Marcado}"
                                                  Click="on_marcar_fila"
                                                  HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="N" Width="32"
                                            DisplayMemberBinding="{Binding Orden}"/>
                            <GridViewColumn Header="ElementId" Width="82"
                                            DisplayMemberBinding="{Binding Id}"/>
                            <GridViewColumn Header="Categoria" Width="125"
                                            DisplayMemberBinding="{Binding Categoria}"/>
                            <GridViewColumn Header="Familia" Width="145"
                                            DisplayMemberBinding="{Binding Familia}"/>
                            <GridViewColumn Header="Tipo" Width="145"
                                            DisplayMemberBinding="{Binding Tipo}"/>
                            <GridViewColumn Header="Punto de insercion (m)" Width="225"
                                            DisplayMemberBinding="{Binding Punto}"/>
                            <GridViewColumn Header="Conect." Width="60"
                                            DisplayMemberBinding="{Binding Conectores}"/>
                            <GridViewColumn Header="Estado" Width="82"
                                            DisplayMemberBinding="{Binding Estado}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <TextBlock Grid.Row="2" Margin="2,6,2,0"
                           Style="{StaticResource Dato}"
                           Text="Marca dos o mas filas validas. La columna N es el recorrido de la tuberia: se calcula por la posicion de los elementos (extremo a extremo, sin cruces), no por el orden de seleccion."/>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource Dato}"
                       Text="Pipe.Create se ejecutara en una transaccion unica y se podra deshacer con Ctrl+Z."/>
            <Button Grid.Column="1" Name="btn_crear"
                    Content="CREAR TUBERIA" Width="170" Height="36"
                    Style="{StaticResource Primario}" Click="on_crear"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#0A2540" Height="30"
                    CornerRadius="2" Margin="0,0,8,0">
                <TextBlock Name="txt_estado" Text="Listo." Foreground="White"
                           Margin="10,0" FontWeight="SemiBold" FontSize="11"/>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Name="btn_registro" Content="Guardar registro"
                        Click="on_guardar_registro"/>
                <Button Name="btn_cerrar" Content="Cerrar" Width="90"
                        Click="on_cerrar"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
