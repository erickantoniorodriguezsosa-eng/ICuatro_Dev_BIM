<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generador de Elementos BIM (CAD - Familias)"
        Height="860" Width="1240"
        MinHeight="640" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="12"
        Background="#F4F5F7">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="#EAECEF"/>
            <Setter Property="BorderBrush" Value="#C0C6CF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#005FB8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#004C99"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="140"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1 · ARCHIVOS CAD -->
        <GroupBox Grid.Row="0" Header="1 · Archivos CAD vinculados / importados">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ListView Grid.Column="0" Name="lv_cads" BorderBrush="#D0D5DD">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Sel." Width="36">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Id" Width="60" DisplayMemberBinding="{Binding Id}"/>
                            <GridViewColumn Header="Nombre" Width="230" DisplayMemberBinding="{Binding Nombre}"/>
                            <GridViewColumn Header="Clasificacion" Width="100" DisplayMemberBinding="{Binding Tipo}"/>
                            <GridViewColumn Header="Estado" Width="90" DisplayMemberBinding="{Binding Estado}"/>
                            <GridViewColumn Header="Ruta del archivo" Width="380" DisplayMemberBinding="{Binding Ruta}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <Button Name="btn_detectar_cad" Content="Detectar CAD" Width="160" Click="on_detectar_cad"/>
                    <Button Name="btn_cad_select_all" Content="Marcar Todos" Width="160" Click="on_cad_select_all"/>
                    <Button Name="btn_cad_deselect_all" Content="Desmarcar" Width="160" Click="on_cad_deselect_all"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <TabControl Grid.Row="1" Margin="0,0,0,6">
            <TabItem Header="Bloques CAD">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.7*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
        <!-- 2 · BLOQUES DEL CAD -->
        <GroupBox Grid.Row="0" Header="2 · Bloques encontrados en el/los CAD marcado(s)">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Button Name="btn_analizar_bloques" Content="Analizar Bloques" Width="150" Click="on_analizar_bloques"/>
                    <Button Name="btn_bloque_select_all" Content="Marcar Todos" Click="on_bloque_select_all"/>
                    <Button Name="btn_bloque_deselect_all" Content="Desmarcar" Click="on_bloque_deselect_all"/>
                    <Button Name="btn_bloque_select_pendientes" Content="Marcar sin asignar" Width="150" Click="on_bloque_select_pendientes"
                            ToolTip="Marca los bloques a los que todavia no se les ha asignado familia y tipo."/>
                    <Button Name="btn_diagnostico" Content="Guardar Diagnostico" Width="160" Click="on_guardar_diagnostico"
                            ToolTip="Vuelca a un .txt el arbol de geometria real del CAD: clase, simbolo, categoria y transformada de cada objeto. Usalo si la deteccion de bloques no sale bien."/>
                    <TextBlock Name="lbl_resumen_bloques" Text="Sin bloques analizados." VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#475569"/>
                </StackPanel>

                <ListView Grid.Row="1" Name="lv_bloques" BorderBrush="#D0D5DD" Margin="0,4,0,0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Sel." Width="36">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Bloque (DWG)" Width="200" DisplayMemberBinding="{Binding Nombre}"/>
                            <GridViewColumn Header="Id simbolo" Width="70" DisplayMemberBinding="{Binding IdSimbolo}"/>
                            <GridViewColumn Header="Capa" Width="120" DisplayMemberBinding="{Binding Capa}"/>
                            <GridViewColumn Header="Inserciones" Width="75" DisplayMemberBinding="{Binding Instancias}"/>
                            <GridViewColumn Header="Familia asignada" Width="190" DisplayMemberBinding="{Binding Familia}"/>
                            <GridViewColumn Header="Tipo asignado" Width="190" DisplayMemberBinding="{Binding Tipo}"/>
                            <GridViewColumn Header="Estado" Width="110" DisplayMemberBinding="{Binding Estado}"/>
                            <GridViewColumn Header="Z min (m)" Width="70" DisplayMemberBinding="{Binding ZMinTxt}"/>
                            <GridViewColumn Header="Z max (m)" Width="70" DisplayMemberBinding="{Binding ZMaxTxt}"/>
                            <GridViewColumn Header="Aviso" Width="140" DisplayMemberBinding="{Binding Aviso}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </GroupBox>

        <!-- 3 · ASIGNACION DE FAMILIA Y TIPO -->
        <GroupBox Grid.Row="1" Header="3 · Familia y tipo que corresponde a los bloques marcados">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="#475569" Margin="2,0,2,6">
                    Marca arriba los bloques, elige aqui la familia y el tipo, y pulsa "Asignar a los bloques marcados". Se puede repetir con distintas parejas de bloques hasta dejar cada uno con su familia y su tipo.
                </TextBlock>

                <!-- FAMILIA -->
                <Grid Grid.Row="1" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Familia:" VerticalAlignment="Center" FontWeight="SemiBold"/>

                    <ComboBox Grid.Column="1" Name="cmb_familias" Height="26" VerticalContentAlignment="Center"
                              DisplayMemberPath="Display" SelectionChanged="on_familia_changed"/>

                    <TextBox Grid.Column="2" Name="txt_familia_buscar" Width="190" Height="26" Margin="6,0,0,0"
                             Padding="4,2" VerticalContentAlignment="Center" TextChanged="on_familia_buscar"
                             ToolTip="Filtra el desplegable por nombre de familia o de categoria."/>

                    <Button Grid.Column="3" Name="btn_recargar_familias" Content="Recargar" Width="90" Click="on_recargar_familias"/>
                </Grid>

                <!-- TIPO -->
                <Grid Grid.Row="2" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Tipo:" VerticalAlignment="Center" FontWeight="SemiBold"/>

                    <ComboBox Grid.Column="1" Name="cmb_tipos" Height="26" VerticalContentAlignment="Center"
                              DisplayMemberPath="Display" SelectionChanged="on_tipo_changed"/>

                    <TextBlock Grid.Column="2" Name="lbl_asignacion" Text="Elige una familia para ver sus tipos."
                               VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#475569" TextWrapping="Wrap" MaxWidth="420"/>
                </Grid>

                <StackPanel Grid.Row="3" Orientation="Horizontal">
                    <Button Name="btn_asignar" Style="{StaticResource PrimaryButton}" Content="Asignar a los bloques marcados" Width="240" Click="on_asignar"/>
                    <Button Name="btn_asignar_auto" Content="Asignar por nombre (tipo = nombre del bloque)" Width="300" Click="on_asignar_auto"
                            ToolTip="Para cada bloque marcado busca, dentro de la familia elegida, el tipo que se llama igual que el bloque. Es el criterio del grafo de Dynamo."/>
                    <Button Name="btn_quitar_asignacion" Content="Quitar asignacion" Width="150" Click="on_quitar_asignacion"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 4 · GENERAR -->
        <Border Grid.Row="2" Background="#EEF6EE" BorderBrush="#BBD8BB" BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="0,0,0,6">
            <WrapPanel Orientation="Horizontal">
                <Button Name="btn_generar" Style="{StaticResource PrimaryButton}" Content="4 · Generar Elementos BIM" Width="210" Click="on_generar"
                        ToolTip="Coloca un ejemplar de la familia y tipo asignados por cada insercion de los bloques marcados, en su punto y con su giro."/>
                <CheckBox Name="chk_evitar_duplicados" Content="Evitar duplicados" VerticalAlignment="Center" Margin="10,0,0,0" IsChecked="True"
                          ToolTip="No coloca un elemento donde ya hay uno del mismo tipo (tolerancia 1 cm). Es lo que impide apilar elementos al volver a generar sobre un CAD ya procesado."/>
                <CheckBox Name="chk_seleccionar_al_cerrar" Content="Dejar seleccionados en Revit al cerrar" VerticalAlignment="Center" Margin="10,0,0,0" IsChecked="True"/>
                <TextBlock Name="lbl_resumen_generacion" Text="" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#475569"/>
            </WrapPanel>
        </Border>

        <!-- RESULTADOS -->
        <GroupBox Grid.Row="3" Header="Resultado de la generacion">
            <ListView Name="lv_resultados" BorderBrush="#D0D5DD">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Bloque (DWG)" Width="220" DisplayMemberBinding="{Binding Bloque}"/>
                        <GridViewColumn Header="Familia : Tipo" Width="320" DisplayMemberBinding="{Binding Tipo}"/>
                        <GridViewColumn Header="Colocados" Width="80" DisplayMemberBinding="{Binding Colocados}"/>
                        <GridViewColumn Header="Omitidos" Width="75" DisplayMemberBinding="{Binding Omitidos}"/>
                        <GridViewColumn Header="Fallidos" Width="70" DisplayMemberBinding="{Binding Fallidos}"/>
                        <GridViewColumn Header="Detalle" Width="400" DisplayMemberBinding="{Binding Detalle}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>

                </Grid>
            </TabItem>
<TabItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Header="Capas · Líneas y curvas">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Selecciona los CAD arriba y analiza sus capas. Incluye líneas, polilíneas por tramos, arcos, círculos, elipses y splines que Revit exponga como curvas; también dentro de bloques." TextWrapping="Wrap" Foreground="#475569" Margin="4"/>
            <WrapPanel>
                <Button Content="Analizar capas" Click="on_curvas_analizar" Style="{StaticResource PrimaryButton}"/>
                <Button Content="Marcar todas" Click="on_curvas_marcar"/>
                <Button Content="Desmarcar" Click="on_curvas_desmarcar"/>
            </WrapPanel>
            <TextBlock Name="txt_resumen_curvas" Text="Sin capas analizadas." TextWrapping="Wrap" Margin="4"/>
        </StackPanel>
        <ListView Grid.Row="1" Name="lv_capas_curvas" Margin="0,4" BorderBrush="#D0D5DD">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Sel." Width="36">
                        <GridViewColumn.CellTemplate><DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                        </DataTemplate></GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="CAD" Width="150" DisplayMemberBinding="{Binding Cad}"/>
                    <GridViewColumn Header="Capa" Width="180" DisplayMemberBinding="{Binding Capa}"/>
                    <GridViewColumn Header="Tramos" Width="65" DisplayMemberBinding="{Binding Cantidad}"/>
                    <GridViewColumn Header="Geometría" Width="150" DisplayMemberBinding="{Binding Geometria}"/>
                    <GridViewColumn Header="Familia" Width="170" DisplayMemberBinding="{Binding Familia}"/>
                    <GridViewColumn Header="Tipo" Width="140" DisplayMemberBinding="{Binding Tipo}"/>
                    <GridViewColumn Header="Modo asignado" Width="180" DisplayMemberBinding="{Binding Modo}"/>
                    <GridViewColumn Header="Resultado / errores" Width="420" DisplayMemberBinding="{Binding Detalle}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <GroupBox Grid.Row="2" Header="Familia y tipo para las capas marcadas">
            <StackPanel>
                <TextBlock Text="Lineal: una familia por tramo. Puntual: un ejemplar en el punto medio o repetido por distancia. La separación reinicia en cada tramo y no repite su extremo final. La asignación se guarda por capa." TextWrapping="Wrap" Foreground="#475569" Margin="4"/>
                <Grid Margin="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Familia:" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" Name="cmb_familias_curvas" DisplayMemberPath="Display" SelectionChanged="on_curvas_familia" MinHeight="26"/>
                    <TextBox Grid.Column="2" Name="txt_buscar_curvas" TextChanged="on_curvas_buscar" Margin="6,0" ToolTip="Buscar familia o categoría"/>
                    <Button Grid.Column="3" Content="Recargar familias" Click="on_recargar_familias"/>
                </Grid>
                <Grid Margin="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Tipo:" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" Name="cmb_tipos_curvas" DisplayMemberPath="Display" MinHeight="26"/>
                </Grid>
                <WrapPanel Margin="4">
                    <TextBlock Text="Colocación:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Name="cmb_modo_curvas" Width="245" MinHeight="26">
                        <ComboBoxItem Content="Familia lineal sobre cada tramo"/>
                        <ComboBoxItem Content="Familia puntual en el punto medio"/>
                        <ComboBoxItem Content="Familia puntual cada distancia"/>
                    </ComboBox>
                    <TextBlock Text="Separación (m):" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <TextBox Name="txt_paso_curvas" Text="1.00" Width="75" MinHeight="26"/>
                    <CheckBox Name="chk_aproximar_curvas" Content="Segmentar curvas para familias rectas" Margin="12,0" VerticalAlignment="Center" ToolTip="Aproxima con tramos rectos según la teselación de Revit. Vuelve a asignar después de cambiar esta opción."/>
                </WrapPanel>
                <CheckBox Name="chk_soporte_3d" Content="CAD 3D con suelos auxiliares: temporalmente deshabilitado" IsChecked="False" IsEnabled="False" Margin="4,6"/>
                <TextBlock Text="El modo con suelos auxiliares está deshabilitado tras un cierre de Revit. Los recorridos inclinados necesitan otro método de modelado. En bifurcaciones horizontales se generan ramas independientes." TextWrapping="Wrap" Margin="4" Foreground="#475569"/>
                <WrapPanel>
                    <Button Content="Asignar a capas marcadas" Click="on_curvas_asignar" Style="{StaticResource PrimaryButton}"/>
                    <Button Content="Quitar asignación" Click="on_curvas_quitar"/>
                </WrapPanel>
            </StackPanel>
        </GroupBox>
        <Border Grid.Row="3" Background="#EEF6EE" BorderBrush="#BBD8BB" BorderThickness="1" Padding="6">
            <WrapPanel>
                <Button Content="Generar familias desde capas" Click="on_curvas_generar" Style="{StaticResource PrimaryButton}"/>
                <CheckBox Name="chk_duplicados_curvas" Content="Evitar duplicados" IsChecked="True" VerticalAlignment="Center" Margin="12,0" ToolTip="Puntuales: mismo tipo a menos de 1 cm. Lineales: mismo tipo, vista y recorrido, comparado con precisión de redondeo."/>
                <TextBlock Text="La selección al cerrar se configura en la pestaña Bloques CAD." VerticalAlignment="Center" Foreground="#475569"/>
            </WrapPanel>
        </Border>
    </Grid>
</TabItem>

        </TabControl>
        <!-- BARRA DE ESTADO Y CIERRE -->
        <Grid Grid.Row="2" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#0A2540" Height="30" CornerRadius="2" Margin="0,0,8,0">
                <TextBlock Name="txt_status_bar" Text="Listo." Foreground="White" VerticalAlignment="Center" Margin="10,0" FontWeight="SemiBold" FontSize="11"/>
            </Border>
            <Button Grid.Column="1" Content="Cerrar" Width="90" Click="on_close"/>
        </Grid>
    </Grid>
</Window>
